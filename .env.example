# Configuración de la UI
# URL del WebSocket al que se conecta la UI (Mara OS o bridge local)
VITE_MARA_WS_URL=ws://localhost:8765

# Configuración del servidor bridge (server/index.mjs, carga .env con dotenv)
# Puerto del servidor (sirve dist/, WebSocket y API HTTP)
MARA_SERVER_PORT=8765

# Opcional: dirección del WebSocket de Mara OS.
# El bridge reenvía los comandos de la UI y difunde los eventos de Mara OS.
# Descomenta y configura la IP de tu Mara OS.
# MARA_BRAIN_WS_URL=ws://192.168.1.50:9000