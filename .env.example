# Configuración de la UI (modo de conexión)
# "mock" (sin backend) o "ws" (WebSocket real con Mara OS o con el bridge)
VITE_MARA_MODE=ws

# URL del WebSocket al que se conecta la UI
VITE_MARA_WS_URL=ws://localhost:8765

# Configuración del servidor bridge (server/index.mjs)
# Puerto del servidor (sirve dist/, WebSocket y API HTTP)
MARA_SERVER_PORT=8765

# Opcional: puente hacia el cerebro de Mara OS.
# El bridge reenvía ahí los comandos de la UI y difunde sus eventos.
# MARA_BRAIN_WS_URL=ws://192.168.1.50:9000
